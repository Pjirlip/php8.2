# Apache Settings
APACHE_SERVER_NAME=example.de
DOCUMENT_ROOT=/var/www/html/public/
PORT=80

# Mail Settings
SMTP_SERVER=host
SMTP_PORT=25
SMTP_FROM=mail@example.com

# Typo3 Scheduler and form cleanup run as Kubernetes CronJobs, see cron-jobs/.
# CLEANUP_FORM_KEEP_DAYS / CLEANUP_FORM_DRY_RUN are set on the cleanup CronJob, not on the web container.

# Apache worker pool (K1). Leave APACHE_MAX_REQUEST_WORKERS empty to derive it from the container
# memory limit: floor((limit_MiB - APACHE_BASELINE_MEMORY_MB) / APACHE_CHILD_MEMORY_MB)
# APACHE_MAX_REQUEST_WORKERS=
# APACHE_CHILD_MEMORY_MB=100
# APACHE_BASELINE_MEMORY_MB=256
# APACHE_MAX_CONNECTIONS_PER_CHILD=1000
# APACHE_TIMEOUT=120
# "None" disables .htaccess completely; ship the rules via /etc/apache2/site.d/*.conf instead (K2)
# APACHE_ALLOW_OVERRIDE=All

# PHP OPcache / timeouts (K2, H4)
# PHP_OPCACHE_MEMORY=192
# PHP_OPCACHE_MAX_FILES=50000
# PHP_OPCACHE_VALIDATE_TIMESTAMPS=1
# PHP_OPCACHE_REVALIDATE_FREQ=60
# PHP_MYSQLND_NET_READ_TIMEOUT=300

# Server Config (Default Vars given)
# TZ=Europe/Berlin
# PHP_MEMORY_LIMIT=256M
# PHP_MAX_EXEC_TIME=240
# PHP_POST_AND_UPLOAD_MAX_SIZE=50M
