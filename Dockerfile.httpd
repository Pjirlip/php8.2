# Apache container: event MPM, serves static files and .htaccess rules itself and proxies PHP to the
# php-fpm container of the same pod (127.0.0.1:9000). No PHP inside, so a connection costs a thread,
# not a PHP process; keep-alive and parallel asset downloads no longer starve PHP workers.
FROM debian:trixie-slim
LABEL maintainer="Philipp Dippel <philipp.dippel@propeller.de>"
SHELL ["/bin/bash", "-c"]

# groupadd/useradd from the essential passwd package: trixie-slim has no adduser wrapper
RUN groupadd --gid 1000 propeller && useradd --system --uid 1000 --gid propeller propeller

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Europe/Berlin \
    APACHE_LOCK_DIR=/var/lock/apache2 \
    APACHE_LOG_DIR=/var/log/apache2 \
    APACHE_PID_FILE=/var/run/apache2/apache2.pid \
    APACHE_SERVER_NAME=localhost \
    APACHE_RUN_USER=propeller \
    APACHE_RUN_GROUP=propeller \
    APACHE_RUN_DIR=/var/run/apache2 \
    DOCUMENT_ROOT=/var/www/html \
    PORT=80
# Apache tuning. MaxRequestWorkers are threads (event MPM), not PHP processes; 150 is plenty for one site.
# APACHE_PROXY_TIMEOUT bounds how long Apache waits for php-fpm and must exceed the longest PHP request.
ENV APACHE_TIMEOUT=120 \
    APACHE_PROXY_TIMEOUT=300 \
    APACHE_ALLOW_OVERRIDE=All \
    APACHE_MAX_REQUEST_WORKERS=150 \
    APACHE_THREADS_PER_CHILD=25 \
    PHP_FPM_HOST=127.0.0.1 \
    PHP_FPM_PORT=9000

RUN apt-get update && \
    apt-get install -y --no-install-recommends apache2 ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

COPY ./config/httpd/apache2.conf /etc/apache2/apache2.conf
COPY ./config/httpd/mpm_event.conf /etc/apache2/mods-available/mpm_event.conf
COPY ./config/httpd/000-default.conf /etc/apache2/sites-available/000-default.conf
COPY ./scripts/httpd-entrypoint.sh /usr/local/bin/

# Debian's envvars become overridable defaults (same approach as the official php images); event MPM with
# proxy_fcgi and the module set of the mod_php image; no cgi-bin and no second access log (H5)
RUN chmod +x /usr/local/bin/httpd-entrypoint.sh && \
    sed -ri 's/^export ([^=]+)=(.*)$/: ${\1:=\2}\nexport \1/' /etc/apache2/envvars && \
    (a2dismod -q mpm_prefork mpm_worker || true) && \
    a2enmod -q mpm_event proxy proxy_fcgi rewrite deflate headers mime expires filter setenvif env authz_core auth_basic alias remoteip status && \
    (a2disconf -q serve-cgi-bin other-vhosts-access-log || true) && \
    rm -f /etc/apache2/conf-enabled/serve-cgi-bin.conf /etc/apache2/conf-enabled/other-vhosts-access-log.conf && \
    rm -rf /var/www/html/* && \
    mkdir -p "$APACHE_LOCK_DIR" "$APACHE_RUN_DIR" "$APACHE_LOG_DIR" && \
    chown "$APACHE_RUN_USER:$APACHE_RUN_GROUP" "$APACHE_LOCK_DIR" "$APACHE_RUN_DIR" "$APACHE_LOG_DIR" && \
    # static health endpoint for Kubernetes probes (H3) and drop-in directory for per-site Apache rules (K2)
    mkdir -p /opt/propeller/healthz /etc/apache2/site.d && echo ok > /opt/propeller/healthz/index.html && \
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Validate the complete configuration at build time without starting a daemon (H6)
RUN apache2ctl -t

EXPOSE $PORT

# SIGWINCH is Apache's graceful stop; Kubernetes sends it on pod termination (bounded by GracefulShutdownTimeout)
STOPSIGNAL SIGWINCH

ENTRYPOINT ["httpd-entrypoint.sh"]
